,/sudo/);assert.equal(bashHardDenied(\"full\",\"sudo ls\"),null);assert.match(bashHardDenied(\"long\",\"sudo ls\")??\"\",/sudo/)})});describe(\"bashEscapesWorkspace\",()=>{it(\"blocks Ask redirects and secret files\",()=>{assert.match(bashEscapesWorkspace(\"ask\",ws,ws,\"echo hi > /tmp/x\")??\"\",/工作区外|受保护/);assert.match(bashEscapesWorkspace(\"ask\",ws,ws,\"cat .env\")??\"\",/受保护/);assert.match(bashEscapesWorkspace(\"ask\",ws,ws,\"cat /etc/passwd\")??\"\",/受保护/)})});describe(\"scrubEnv\",()=>{it(\"strips api keys and secret-like variables\",()=>{const out=scrubEnv({PATH:\"/usr/bin\",api_key:\"sk-secret\",OPENAI_API_KEY:\"sk-other\",DATABASE_URL:\"postgres://localhost/db\",MY_TOKEN:\"abc\"});assert.equal(out.PATH,\"/usr/bin\");assert.equal(out.api_key,void 0);assert.equal(out.OPENAI_API_KEY,void 0);assert.equal(out.DATABASE_URL,void 0);assert.equal(out.MY_TOKEN,void 0)})});\n","warnings":[],"map":{"version":3,"mappings":"AAAA,OAAO,WAAY,qBACnB,OAAS,YAAe,UACxB,OAAS,SAAY,YACrB,OAAS,SAAU,OAAU,YAC7B,OACE,cACA,qBACA,eACA,aACA,WACA,kBACA,eACA,aACK,eAEP,MAAM,GAAK,mBAEX,SAAS,oBAAqB,IAAM,CAClC,GAAG,oCAAqC,IAAM,CAC5C,OAAO,MAAM,kBAAkB,GAAI,EAAE,EAAG,IAAI,EAC5C,OAAO,MAAM,kBAAkB,GAAI,GAAG,EAAE,eAAe,EAAG,IAAI,CAChE,CAAC,EAED,GAAG,sCAAuC,IAAM,CAC9C,OAAO,MAAM,kBAAkB,GAAI,mBAAmB,EAAG,KAAK,EAC9D,OAAO,MAAM,kBAAkB,GAAI,WAAW,EAAG,KAAK,EACtD,OAAO,MAAM,kBAAkB,GAAI,GAAG,EAAE,YAAY,EAAG,KAAK,CAC9D,CAAC,CACH,CAAC,EAED,SAAS,aAAc,IAAM,CAC3B,GAAG,iCAAkC,IAAM,CACzC,OAAO,MAAM,WAAW,aAAa,GAAK,GAAI,KAAK,EACnD,OAAO,MAAM,WAAW,KAAK,QAAQ,EAAG,aAAa,CAAC,GAAK,GAAI,KAAK,CACtE,CAAC,EAED,GAAG,yBAA0B,IAAM,CACjC,OAAO,MAAM,WAAW,GAAG,EAAE,eAAe,EAAG,IAAI,CACrD,CAAC,EAED,GAAG,2CAA4C,IAAM,CACnD,OAAO,MAAM,WAAW,GAAG,EAAE,OAAO,GAAK,GAAI,KAAK,EAClD,OAAO,MAAM,WAAW,GAAG,EAAE,iBAAiB,GAAK,GAAI,KAAK,CAC9D,CAAC,CACH,CAAC,EAED,SAAS,iBAAkB,IAAM,CAC/B,GAAG,0CAA2C,IAAM,CAClD,MAAM,OAAS,eAAe,MAAO,GAAI,mBAAoB,QAAQ,EACrE,OAAO,MAAM,QAAU,GAAI,MAAM,CACnC,CAAC,EAED,GAAG,yCAA0C,IAAM,CACjD,OAAO,MAAM,eAAe,MAAO,GAAI,GAAG,EAAE,YAAa,QAAQ,EAAG,IA