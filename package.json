{
  "name": "socode",
  "version": "0.1.3",
  "description": "本机终端里的编程 Agent",
  "license": "MIT",
  "type": "module",
  "bin": {
    "socode": "bin/socode.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tm-Ys/socode.git"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "chat": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pack:release": "bash scripts/pack-release.sh",
    "pack:runtime": "tsx src/runtime-pack.ts --pack-runtime",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
